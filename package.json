{
  "name": "libav-wasm",
  "version": "0.8.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Banou26/libav-wasm.git"
  },
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "types": "build/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev-wasm-cmd\" \"npm run dev-web\" \"npm run worker-build-dev\"",
    "dev-wasm-cmd": "nodemon -e cpp --exec \"npm run make-docker-debug\"",
    "dev-wasm": "concurrently \"nodemon -e cpp --exec \\\"npm run make-docker-debug\\\"\"",
    "build-worker": "vp build --config vite-worker.config.ts",
    "make-docker": "docker compose run --rm libav-wasm make",
    "docker-clean": "docker compose up --remove-orphans",
    "dev-web": "vp dev --port 1234",
    "vite-build": "vp build",
    "vite-build-dev": "vp build --watch",
    "worker-build-dev": "nodemon -e ts --watch src/worker --exec \"npm run build-worker\"",
    "build": "npm run make-docker && vp build && npm run build-worker && npm run types && npm run copy-wasm",
    "prepublishOnly": "npm run build",
    "types": "tsc",
    "copy-wasm": "copyfiles -u 1 dist/libav.wasm dist/libav-jspi.wasm build && shx mv ./build/worker/index.d.ts ./build/worker.d.ts && shx rm -rf ./build/worker",
    "preview": "vp preview",
    "make-docker-debug": "docker compose run --rm libav-wasm make DEBUG=1",
    "fixtures": "node scripts/fixtures.mjs",
    "test": "playwright test",
    "test:large": "LIBAV_LARGE_FIXTURE=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@types/emscripten": "^1.40.0",
    "concurrently": "^7.6.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^2.0.22",
    "osra": "^0.6.12",
    "p-queue": "^7.3.0",
    "shx": "^0.3.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  }
}
