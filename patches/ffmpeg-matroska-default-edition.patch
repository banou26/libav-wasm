+/* Only the default edition is read, as RFC 9559 20.1.2 defines it: the first flagged default, else the
+ * first. Each edition is a whole alternative list, so joining them put a later edition's chapters among
+ * the first's. */
+static const EbmlList *matroska_chapters_list(const MatroskaDemuxContext *matroska)
+{
+    static const EbmlList none;
+    const MatroskaEdition *editions = matroska->editions.elem;
+    for (int i = 0; i < matroska->editions.nb_elem; i++)
+        if (editions[i].flag_default)
+            return &editions[i].chapters;
+    return matroska->editions.nb_elem ? &editions[0].chapters : &none;
+}
